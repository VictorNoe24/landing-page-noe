---
import { withBase } from '../utils/withBase.js';

const contactHref = withBase('/#cotizar');
---

<a href={contactHref} class="whatsapp-float" aria-label="Contactar por WhatsApp">
	<svg aria-hidden="true" viewBox="0 0 32 32" fill="currentColor">
		<path d="M16.04 4.01a11.82 11.82 0 0 0-10.1 17.93L4.5 27.25l5.44-1.42A11.82 11.82 0 1 0 16.04 4Zm0 21.67a9.75 9.75 0 0 1-4.98-1.36l-.36-.21-3.22.84.86-3.14-.24-.38a9.76 9.76 0 1 1 7.94 4.25Zm5.36-7.31c-.29-.15-1.74-.86-2.01-.96-.27-.1-.47-.15-.67.15-.2.29-.77.96-.95 1.16-.17.2-.35.22-.64.07-.29-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.64-2.03-.17-.29-.02-.45.13-.6.13-.13.29-.35.44-.52.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.29-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.21 5.1 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.74-.71 1.99-1.39.25-.68.25-1.27.17-1.39-.07-.12-.26-.19-.56-.34Z" />
	</svg>
</a>

<script is:inline>
	(() => {
		const floatButton = document.querySelector('.whatsapp-float');
		const contactSection = document.getElementById('cotizar');
		const footer = document.querySelector('.site-footer');

		if (!floatButton || !contactSection) return;

		const updateState = (entries) => {
			const isCompactViewport = window.matchMedia('(max-width: 760px)').matches;
			const shouldHide = isCompactViewport && entries.some((entry) => entry.isIntersecting);
			floatButton.classList.toggle('is-hidden-on-mobile', shouldHide);
		};

		const observer = new IntersectionObserver(updateState, {
			root: null,
			threshold: 0.15,
		});

		observer.observe(contactSection);
		if (footer) observer.observe(footer);
	})();
</script>

<style>
	.whatsapp-float {
		position: fixed;
		right: max(16px, env(safe-area-inset-right));
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 70;
		display: grid;
		width: 58px;
		height: 58px;
		place-items: center;
		border-radius: 999px;
		background: var(--color-whatsapp);
		color: var(--color-white);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
		text-decoration: none;
		transition:
			background 180ms ease,
			transform 180ms ease;
	}

	.whatsapp-float:hover,
	.whatsapp-float:focus-visible {
		background: var(--color-whatsapp-hover);
		transform: scale(1.05);
	}

	.whatsapp-float svg {
		width: 34px;
		height: 34px;
	}

	@media (max-width: 760px) {
		.whatsapp-float {
			right: max(12px, env(safe-area-inset-right));
			bottom: max(12px, calc(env(safe-area-inset-bottom) + 12px));
			width: 50px;
			height: 50px;
			box-shadow: 0 10px 22px rgba(0, 0, 0, 0.24);
		}

		.whatsapp-float svg {
			width: 28px;
			height: 28px;
		}

		.whatsapp-float.is-hidden-on-mobile {
			opacity: 0;
			pointer-events: none;
			transform: translateY(14px) scale(0.92);
		}
	}
</style>
