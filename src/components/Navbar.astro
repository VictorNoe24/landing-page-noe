---
import { Image } from 'astro:assets';
import MobileNav from './MobileNav.jsx';
import ThemeToggle from './ThemeToggle.jsx';
import { withBase } from '../utils/withBase.js';
import logoAsset from '../assets/logo.png';

const navItems = [
	{ label: 'Inicio', href: withBase('/#inicio') },
	{ label: 'Nosotros', href: withBase('/#nosotros') },
	{ label: 'Servicios', href: withBase('/#servicios') },
	{ label: 'Galería', href: withBase('/#galeria') },
	{ label: 'Testimonios', href: withBase('/#testimonios') },
];

const logoUrl = withBase('/images/logo.png');
const homeHref = withBase('/#inicio');
const quoteHref = withBase('/#cotizar');
---

<header class="site-header">
	<nav class="navbar" aria-label="Principal">
		<a class="brand" href={homeHref} aria-label="Noe Flores Avilés - inicio">
			<Image class="brand-logo" src={logoAsset} alt="Noe Flores Avilés" width={126} height={48} loading="eager" fetchpriority="high" />
		</a>

		<div class="nav-actions">
			<div class="nav-links">
				{
					navItems.map((item) => (
						<a href={item.href}>
							{item.label}
						</a>
					))
				}
			</div>

			<ThemeToggle client:load className="nav-theme-toggle" />
			<a class="quote-button" href={quoteHref}>Cotizar Proyecto</a>
		</div>

		<MobileNav client:load navItems={navItems} logoUrl={logoUrl} />
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 50;
		width: 100%;
		background: color-mix(in srgb, var(--color-surface) 92%, transparent);
		border-bottom: 1px solid var(--color-border-muted);
		box-shadow: 0 2px 8px var(--color-shadow-soft);
		backdrop-filter: blur(12px);
	}

	.navbar {
		width: min(1120px, calc(100% - 48px));
		min-height: 80px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		width: 148px;
		padding: 6px 8px;
		border-radius: 12px;
		text-decoration: none;
		transition: background 180ms ease;
	}

	.brand-logo {
		display: block;
		width: 126px;
		height: auto;
		max-height: 48px;
		flex: 0 0 auto;
		object-fit: contain;
	}

	.nav-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 32px;
		flex: 1;
	}

	.nav-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 32px;
	}

	.nav-links a {
		color: var(--color-text-muted);
		font-size: 16px;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		transition:
			color 180ms ease,
			transform 180ms ease;
	}

	.nav-links a:hover,
	.nav-links a:focus-visible {
		color: var(--color-brand);
	}

	.nav-theme-toggle {
		flex: 0 0 auto;
	}

	.quote-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 24px;
		border-radius: 8px;
		background: var(--color-brand);
		color: var(--color-white);
		font-size: 16px;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 3px 8px color-mix(in srgb, var(--color-brand) 26%, transparent);
		transition:
			background 180ms ease,
			transform 180ms ease,
			box-shadow 180ms ease;
		white-space: nowrap;
	}

	.quote-button:hover,
	.quote-button:focus-visible {
		background: color-mix(in srgb, var(--color-brand) 88%, #000000);
		box-shadow: 0 6px 14px color-mix(in srgb, var(--color-brand) 22%, transparent);
		transform: translateY(-1px);
	}

	:global([data-theme='dark']) .site-header {
		background: rgba(10, 17, 31, 0.82);
		border-bottom-color: rgba(255, 255, 255, 0.08);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
	}

	:global([data-theme='dark']) .brand:hover,
	:global([data-theme='dark']) .brand:focus-visible {
		background: rgba(255, 255, 255, 0.04);
	}

	@media (max-width: 860px) {
		.navbar {
			width: min(calc(100% - 32px), 720px);
			min-height: 76px;
			gap: 16px;
		}

		.brand {
			min-width: auto;
		}

		.brand-logo {
			width: 104px;
			max-height: 44px;
			margin-left: 0;
		}

		.nav-actions {
			gap: 16px;
			min-width: 0;
		}

		.nav-links {
			gap: 16px;
			overflow-x: auto;
			justify-content: flex-start;
			padding: 8px 0;
		}

		.nav-links a {
			font-size: 14px;
			white-space: nowrap;
		}

		.quote-button {
			min-height: 40px;
			padding: 0 14px;
			font-size: 14px;
		}
	}

	@media (max-width: 760px) {
		.navbar {
			width: calc(100% - 24px);
			min-height: 78px;
			display: flex;
			padding: 0;
		}

		.nav-actions {
			display: none;
		}

		.brand {
			width: auto;
		}

		.brand-logo {
			width: 96px;
		}
	}
</style>

<style is:global>
	.mobile-menu-root {
		display: none;
	}

	.mobile-menu-trigger {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.mobile-menu-trigger svg {
		width: 24px;
		height: 24px;
	}

	.mobile-menu-overlay {
		position: fixed;
		inset: 0;
		z-index: 90;
		background: rgba(15, 23, 42, 0.34);
	}

	.mobile-menu-content {
		position: fixed;
		top: 10px;
		left: 16px;
		right: 16px;
		z-index: 100;
		max-height: calc(100svh - 20px);
		overflow-y: auto;
		border: 1px solid var(--color-border-muted);
		border-radius: 20px 20px 4px 4px;
		background: var(--color-surface);
		padding: 18px 12px 30px;
		box-shadow: 0 24px 60px var(--color-shadow-strong);
	}

	.mobile-menu-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 10px 16px;
	}

	.mobile-menu-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.mobile-menu-logo img {
		display: block;
		width: 96px;
		height: auto;
		object-fit: contain;
	}

	.mobile-menu-close {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border: 0;
		border-radius: 10px;
		background: transparent;
		color: var(--color-text-muted);
		cursor: pointer;
	}

	[data-theme='dark'] .mobile-menu-trigger,
	[data-theme='dark'] .mobile-menu-close {
		color: var(--color-text);
	}

	.mobile-menu-close svg {
		width: 24px;
		height: 24px;
	}

	.mobile-menu-links {
		display: grid;
		gap: 6px;
	}

	.mobile-menu-links a {
		display: flex;
		min-height: 40px;
		align-items: center;
		border-radius: 6px;
		color: var(--color-text);
		font-size: 14px;
		font-weight: 750;
		text-decoration: none;
		padding: 0 10px;
	}

	.mobile-menu-links a:first-child {
		background: var(--color-brand-soft-alt);
		color: var(--color-brand);
	}

	.mobile-menu-cta {
		display: flex;
		min-height: 38px;
		align-items: center;
		justify-content: center;
		margin-top: 24px;
		border-radius: 6px;
		background: var(--color-brand);
		color: var(--color-white);
		font-size: 14px;
		font-weight: 950;
		text-decoration: none;
	}

	@media (min-width: 761px) {
		.mobile-menu-root,
		.mobile-menu-overlay,
		.mobile-menu-content {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.mobile-menu-root {
			display: block;
		}
	}
</style>
