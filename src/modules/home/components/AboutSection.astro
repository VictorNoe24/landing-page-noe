---
const values = [
	{
		title: 'Precisión y Detalle',
		description: 'No dejamos nada al azar, cada centímetro cuenta.',
		icon: 'target',
	},
	{
		title: 'Trato Honesto',
		description: 'Presupuestos claros y sin letras chiquitas. Hablamos con la verdad.',
		icon: 'users',
	},
	{
		title: 'Personal Capacitado',
		description: 'Equipo de trabajo respetuoso, limpio y profesional.',
		icon: 'helmet',
	},
];
---

<section id="nosotros" class="about-section">
	<div class="about-inner">
		<div class="about-media" data-scroll-animate="fade-left">
			<div class="experience-card">
				<div class="experience-icon">
					<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
						<path d="M4 12.5h16v6H4v-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
						<path d="M7.5 12.5V9.8a4.5 4.5 0 0 1 9 0v2.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
						<path d="M12 5v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
					</svg>
				</div>
				<div>
					<p>20+</p>
					<span>Años Construyendo</span>
				</div>
			</div>

			<div class="image-frame">
				<img
					src="https://images.unsplash.com/photo-1651862318980-ecefc83c9f38?auto=format&fit=crop&q=80"
					alt="Muro de ladrillo terminado por maestro de obra"
					loading="lazy"
				/>
			</div>
			<div class="media-accent" aria-hidden="true"></div>
		</div>

		<div class="about-content" data-scroll-animate="fade-right" data-scroll-delay="100ms">
			<p class="section-eyebrow">Sobre Nosotros</p>
			<h2>El Maestro de Obra que tu proyecto necesita</h2>

			<p>
				Sabemos lo estresante que puede ser construir o remodelar. Los retrasos, los malos materiales y los presupuestos que se inflan son el miedo de todos. Por eso, en nuestra empresa <strong>nos regimos por la honestidad, el trabajo duro y la excelencia.</strong>
			</p>

			<p>
				Ya sea levantar una barda, construir una casa desde cero o remodelar un baño, tratamos cada hogar como si fuera el nuestro. Conocemos los materiales, el clima y los estilos de México para darte resultados duraderos.
			</p>

			<div class="value-list">
				{
					values.map((item, index) => (
						<div class="value-item" data-scroll-animate="fade-up" data-scroll-delay={`${220 + index * 110}ms`}>
							<div class="value-icon">
								{
									item.icon === 'target' && (
										<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
											<circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8" />
											<circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
											<circle cx="12" cy="12" r="1.4" fill="currentColor" />
										</svg>
									)
								}
								{
									item.icon === 'users' && (
										<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
											<path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.8" />
											<path d="M3.5 19c.45-3.05 2.5-5 5.5-5s5.05 1.95 5.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
											<path d="M16 11.5a2.6 2.6 0 1 0 0-5.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
											<path d="M16.5 14.2c2.25.45 3.65 2.05 4 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
										</svg>
									)
								}
								{
									item.icon === 'helmet' && (
										<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
											<path d="M4 12.5h16v6H4v-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
											<path d="M7.5 12.5V9.8a4.5 4.5 0 0 1 9 0v2.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
											<path d="M12 5v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
										</svg>
									)
								}
							</div>
							<div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.about-section {
		background: #f8fafc;
		color: #0f172a;
		overflow: clip;
		padding: 74px 0 66px;
	}

	.about-inner {
		display: grid;
		width: 100%;
		max-width: 1216px;
		margin: 0 auto;
		padding: 0 24px;
		grid-template-columns: minmax(420px, 584px) minmax(420px, 1fr);
		gap: 72px;
		align-items: center;
	}

	.about-media {
		position: relative;
		min-width: 0;
		min-height: 640px;
	}

	.image-frame {
		position: relative;
		z-index: 2;
		width: 584px;
		height: 700px;
		max-width: 100%;
		overflow: hidden;
		border-radius: 18px;
		background: #d97745;
		box-shadow: 0 24px 48px rgba(15, 23, 42, 0.18);
	}

	.image-frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.media-accent {
		position: absolute;
		right: -24px;
		bottom: -24px;
		z-index: 1;
		width: 390px;
		height: 462px;
		border-radius: 18px;
		background: #005f6b;
	}

	.experience-card {
		position: absolute;
		top: 32px;
		left: -32px;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 16px;
		width: 256px;
		min-height: 104px;
		padding: 20px 24px;
		border-left: 4px solid #071225;
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 22px 40px rgba(15, 23, 42, 0.16);
	}

	.experience-icon,
	.value-icon {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		background: #b9dce1;
		color: #005f6b;
	}

	.experience-icon {
		width: 56px;
		height: 56px;
		border-radius: 999px;
	}

	.experience-icon svg,
	.value-icon svg {
		width: 28px;
		height: 28px;
	}

	.experience-card p {
		margin: 0;
		color: #0f172a;
		font-size: 32px;
		font-weight: 950;
		line-height: 1;
	}

	.experience-card span {
		display: block;
		margin-top: 6px;
		color: #475569;
		font-size: 14px;
		font-weight: 800;
		line-height: 1.25;
	}

	.about-content {
		min-width: 0;
		max-width: 640px;
		padding-top: 6px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.about-media[data-scroll-animate],
		.about-content[data-scroll-animate] {
			opacity: 0;
			will-change: opacity, transform, filter;
		}

		.about-media[data-scroll-animate].is-scroll-visible,
		.about-content[data-scroll-animate].is-scroll-visible {
			opacity: 1;
		}
	}

	.section-eyebrow {
		margin: 0 0 12px;
		color: #005f6b;
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.about-content h2 {
		max-width: 590px;
		width: 100%;
		margin: 0 0 28px;
		color: #0f172a;
		font-size: clamp(36px, 3.2vw, 46px);
		font-weight: 950;
		line-height: 1.18;
		letter-spacing: 0;
		overflow-wrap: anywhere;
	}

	.about-content > p {
		margin: 0 0 26px;
		color: #475569;
		font-size: 18px;
		font-weight: 500;
		line-height: 1.6;
	}

	.about-content strong {
		color: #3f4b5d;
		font-weight: 900;
	}

	.value-list {
		display: grid;
		gap: 22px;
		margin-top: 36px;
	}

	.value-item {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 16px;
		align-items: start;
	}

	.value-icon {
		width: 48px;
		height: 48px;
		border-radius: 8px;
	}

	.value-icon svg {
		width: 24px;
		height: 24px;
	}

	.value-item h3 {
		margin: 0;
		color: #0f172a;
		font-size: 20px;
		font-weight: 950;
		line-height: 1.2;
	}

	.value-item p {
		margin: 8px 0 0;
		color: #475569;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.45;
	}

	@media (prefers-reduced-motion: no-preference) {
		.value-item[data-scroll-animate] {
			opacity: 0;
			will-change: opacity, transform, filter;
		}

		.value-item[data-scroll-animate].is-scroll-visible {
			opacity: 1;
		}
	}

	@media (max-width: 1080px) {
		.about-inner {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.about-media {
			width: min(584px, 100%);
			min-height: auto;
			margin: 0 auto;
		}

		.image-frame {
			height: 620px;
		}

		.about-content {
			max-width: 720px;
			min-width: 0;
			margin: 0 auto;
		}
	}

	@media (max-width: 620px) {
		.about-section {
			padding: 54px 0 58px;
		}

		.about-inner {
			padding: 0 12px;
			gap: 38px;
		}

		.image-frame {
			height: 420px;
			border-radius: 14px;
		}

		.media-accent {
			right: 0;
			bottom: -18px;
			width: 62%;
			height: 180px;
			border-radius: 14px;
		}

		.experience-card {
			top: 14px;
			left: 0;
			width: min(236px, calc(100% - 22px));
			min-height: 86px;
			padding: 14px 16px;
			gap: 14px;
		}

		.experience-icon {
			width: 46px;
			height: 46px;
		}

		.experience-card p {
			font-size: 28px;
		}

		.experience-card span {
			font-size: 13px;
		}

		.about-content h2 {
			font-size: 34px;
		}

		.about-content > p {
			font-size: 16px;
			overflow-wrap: anywhere;
		}
	}

	@media (max-width: 430px) {
		.about-section {
			padding: 46px 0 52px;
		}

		.about-inner {
			padding: 0 10px;
			gap: 34px;
		}

		.image-frame {
			height: 330px;
			border-radius: 12px;
		}

		.media-accent {
			right: 0;
			bottom: -12px;
			width: 60%;
			height: 120px;
			border-radius: 12px;
		}

		.experience-card {
			top: 10px;
			width: min(216px, calc(100% - 16px));
			min-height: 74px;
			padding: 12px 14px;
			gap: 10px;
			border-left-width: 3px;
			border-radius: 10px;
		}

		.experience-icon {
			width: 40px;
			height: 40px;
		}

		.experience-icon svg {
			width: 22px;
			height: 22px;
		}

		.experience-card p {
			font-size: 24px;
		}

		.experience-card span {
			margin-top: 4px;
			font-size: 11px;
			line-height: 1.15;
		}

		.about-content h2 {
			font-size: 30px;
		}

		.value-item {
			grid-template-columns: 44px 1fr;
			gap: 14px;
		}

		.value-icon {
			width: 44px;
			height: 44px;
		}
	}
</style>
