---
const testimonials = [
	{
		quote:
			'El maestro y su equipo remodelaron mi cocina y quedó preciosa. Muy limpios, respetuosos y terminaron justo cuando me dijeron. 100% recomendados.',
		name: 'Doña María Hernández',
		location: 'CDMX',
	},
	{
		quote:
			'He trabajado con varios albañiles, pero ninguno con esta seriedad. Los contraté para la cimentación y obra negra de un local comercial y su trabajo fue impecable.',
		name: 'Ing. Roberto Martínez',
		location: 'Estado de México',
	},
	{
		quote:
			'Me arreglaron un problema de humedad que nadie más podía solucionar y de paso me cambiaron el piso del baño. Precio justo y sin sorpresas al final.',
		name: 'Carlos Velázquez',
		location: 'Querétaro',
	},
];
---

<section id="testimonios" class="testimonials-section" aria-labelledby="testimonials-title">
	<div class="testimonials-inner">
		<div class="testimonials-heading">
			<p>Testimonios</p>
			<h2 id="testimonials-title">Lo que dicen nuestros clientes</h2>
			<span>La mejor recomendación es el trabajo bien hecho y un cliente satisfecho.</span>
		</div>

		<div class="testimonials-grid">
			{
				testimonials.map((testimonial) => (
					<article class="testimonial-card">
						<div class="quote-badge" aria-hidden="true">”</div>
						<div class="stars" aria-label="5 de 5 estrellas">
							<span>★</span>
							<span>★</span>
							<span>★</span>
							<span>★</span>
							<span>★</span>
						</div>
						<blockquote>“{testimonial.quote}”</blockquote>
						<footer>
							<strong>{testimonial.name}</strong>
							<span>{testimonial.location}</span>
						</footer>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.testimonials-section {
		background: #0b1329;
		color: #ffffff;
		padding: 78px 0 82px;
	}

	.testimonials-inner {
		width: min(1216px, calc(100% - 48px));
		margin: 0 auto;
	}

	.testimonials-heading {
		max-width: 760px;
		margin: 0 auto 92px;
		text-align: center;
	}

	.testimonials-heading p {
		margin: 0 0 14px;
		color: #007f87;
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.09em;
		line-height: 1;
		text-transform: uppercase;
	}

	.testimonials-heading h2 {
		margin: 0;
		color: #ffffff;
		font-size: clamp(36px, 3.2vw, 44px);
		font-weight: 950;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.testimonials-heading span {
		display: block;
		margin-top: 20px;
		color: rgba(255, 255, 255, 0.9);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.5;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
	}

	.testimonial-card {
		position: relative;
		min-height: 284px;
		padding: 40px 32px 32px;
		border-radius: 14px;
		background: #ffffff;
		color: #0f172a;
	}

	.quote-badge {
		position: absolute;
		top: -24px;
		left: 32px;
		display: grid;
		width: 50px;
		height: 50px;
		place-items: center;
		border-radius: 999px;
		background: #005f6b;
		color: #ffffff;
		font-size: 48px;
		font-weight: 900;
		line-height: 1;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.16);
	}

	.stars {
		display: flex;
		gap: 6px;
		color: #005f6b;
		font-size: 22px;
		line-height: 1;
	}

	.testimonial-card blockquote {
		margin: 22px 0 0;
		color: #475569;
		font-size: 16px;
		font-style: italic;
		font-weight: 600;
		line-height: 1.6;
	}

	.testimonial-card footer {
		margin-top: 26px;
	}

	.testimonial-card strong {
		display: block;
		color: #0f172a;
		font-size: 18px;
		font-weight: 950;
		line-height: 1.25;
	}

	.testimonial-card footer span {
		display: block;
		margin-top: 6px;
		color: #64748b;
		font-size: 14px;
		font-weight: 650;
		line-height: 1.2;
	}

	@media (max-width: 980px) {
		.testimonials-grid {
			grid-template-columns: 1fr;
			gap: 42px;
		}

		.testimonial-card {
			min-height: auto;
		}
	}

	@media (max-width: 620px) {
		.testimonials-section {
			padding: 58px 0 64px;
		}

		.testimonials-inner {
			width: calc(100% - 24px);
		}

		.testimonials-heading {
			margin-bottom: 56px;
			text-align: left;
		}

		.testimonials-heading h2 {
			font-size: 34px;
		}

		.testimonials-heading span {
			font-size: 16px;
		}

		.testimonial-card {
			padding: 38px 24px 28px;
		}

		.quote-badge {
			left: 24px;
		}
	}

	@media (max-width: 430px) {
		.testimonials-section {
			padding: 48px 0 54px;
		}

		.testimonials-inner {
			width: calc(100% - 20px);
		}

		.testimonials-heading h2 {
			font-size: 30px;
		}

		.testimonials-grid {
			gap: 36px;
		}

		.testimonial-card {
			padding: 36px 20px 24px;
		}

		.testimonial-card blockquote {
			font-size: 15px;
		}
	}
</style>
