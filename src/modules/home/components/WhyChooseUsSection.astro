---
import {
	CheckCircledIcon,
	ClockIcon,
	HandIcon,
	IdCardIcon,
} from '@radix-ui/react-icons';

const reasons = [
	{
		title: 'Puntualidad Absoluta',
		description: 'Entregamos la obra en la fecha acordada. Sabemos que tu tiempo vale dinero y lo respetamos.',
		icon: 'clock',
	},
	{
		title: 'Presupuestos Justos',
		description: 'No inventamos gastos a mitad de la obra. Te damos un presupuesto detallado desde el primer día.',
		icon: 'budget',
	},
	{
		title: 'Garantía de Calidad',
		description: 'Usamos los mejores materiales y técnicas para asegurar que tu construcción dure toda la vida.',
		icon: 'shield',
	},
	{
		title: 'Atención Personalizada',
		description: 'El Maestro siempre está al pendiente. Te mantenemos informado del avance de tu proyecto.',
		icon: 'hand',
	},
];
---

<section class="why-section" aria-labelledby="why-title">
	<div class="why-orb why-orb-right" aria-hidden="true"></div>
	<div class="why-orb why-orb-left" aria-hidden="true"></div>
	<div class="why-inner">
		<div class="why-heading" data-scroll-animate="fade-up">
			<p>Por qué elegirnos</p>
			<h2 id="why-title">La diferencia entre una obra común y un trabajo bien hecho</h2>
		</div>

		<div class="why-grid">
			{
				reasons.map((reason, index) => (
					<article class="why-card" data-scroll-animate="fade-up" data-scroll-delay={`${120 + index * 90}ms`}>
						<div class="why-icon">
							{reason.icon === 'clock' && <ClockIcon aria-hidden="true" />}
							{reason.icon === 'budget' && <IdCardIcon aria-hidden="true" />}
							{reason.icon === 'shield' && <CheckCircledIcon aria-hidden="true" />}
							{reason.icon === 'hand' && <HandIcon aria-hidden="true" />}
						</div>
						<h3>{reason.title}</h3>
						<p>{reason.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.why-section {
		position: relative;
		overflow: hidden;
		background:
			linear-gradient(110deg, var(--color-surface-dark) 0%, var(--color-surface-dark-alt) 56%, var(--color-surface-dark-deep) 100%);
		color: #ffffff;
		padding: 78px 0 80px;
	}

	.why-orb {
		position: absolute;
		border-radius: 999px;
		filter: blur(70px);
		opacity: 0.16;
		pointer-events: none;
	}

	.why-orb-right {
		top: -88px;
		right: -72px;
		width: 240px;
		height: 240px;
		background: var(--color-brand-strong);
	}

	.why-orb-left {
		left: -92px;
		bottom: -96px;
		width: 250px;
		height: 250px;
		background: #2563eb;
	}

	.why-inner {
		width: min(1216px, calc(100% - 48px));
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}

	.why-heading {
		max-width: 760px;
		margin: 0 auto 66px;
		text-align: center;
	}

	.why-heading p {
		margin: 0 0 14px;
		color: var(--color-brand-strong);
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
	}

	.why-heading h2 {
		margin: 0;
		color: #ffffff;
		font-size: clamp(36px, 3.25vw, 44px);
		font-weight: 950;
		line-height: 1.12;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.why-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 32px;
	}

	.why-card {
		min-height: 318px;
		padding: 32px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.06);
		backdrop-filter: blur(9px);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			0 16px 32px rgba(5, 11, 26, 0.18);
		transition:
			background 220ms ease,
			border-color 220ms ease,
			transform 220ms ease;
	}

	.why-card:hover,
	.why-card:focus-within {
		border-color: rgba(0, 95, 107, 0.28);
		background: rgba(255, 255, 255, 0.1);
		transform: translateY(-4px);
	}

	.why-icon {
		display: grid;
		width: 64px;
		height: 64px;
		place-items: center;
		border-radius: 13px;
		background: #ffffff;
		color: var(--color-brand);
		box-shadow: 0 12px 22px rgba(0, 95, 107, 0.16);
	}

	.why-icon svg {
		width: 34px;
		height: 34px;
	}

	.why-card h3 {
		margin: 32px 0 0;
		color: #ffffff;
		font-size: 20px;
		font-weight: 950;
		line-height: 1.35;
	}

	.why-card p {
		margin: 16px 0 0;
		color: rgba(255, 255, 255, 0.86);
		font-size: 15px;
		font-weight: 650;
		line-height: 1.62;
	}

	@media (max-width: 1080px) {
		.why-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.why-section {
			padding: 58px 0 62px;
		}

		.why-inner {
			width: calc(100% - 24px);
		}

		.why-heading {
			margin-bottom: 38px;
			text-align: left;
		}

		.why-heading h2 {
			font-size: 34px;
		}

		.why-grid {
			grid-template-columns: 1fr;
			gap: 22px;
		}

		.why-card {
			min-height: auto;
			padding: 28px;
		}

		.why-card h3 {
			margin-top: 24px;
		}
	}

	@media (max-width: 430px) {
		.why-section {
			padding: 48px 0 54px;
		}

		.why-inner {
			width: calc(100% - 20px);
		}

		.why-heading h2 {
			font-size: 30px;
		}

		.why-card {
			padding: 22px;
		}

		.why-icon {
			width: 56px;
			height: 56px;
		}

		.why-icon svg {
			width: 30px;
			height: 30px;
		}
	}
</style>
