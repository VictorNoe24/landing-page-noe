---
import {
	GearIcon,
	HobbyKnifeIcon,
	LightningBoltIcon,
	MagicWandIcon,
	MixIcon,
	RulerSquareIcon,
} from '@radix-ui/react-icons';

const services = [
	{
		title: 'Albañilería en General',
		description: 'Obra negra, cimentación, levantamiento de muros, castillos, losas y aplanados.',
		image: 'https://images.unsplash.com/photo-1651862318980-ecefc83c9f38?auto=format&fit=crop&q=80',
		icon: 'hobby-knife',
	},
	{
		title: 'Remodelaciones',
		description: 'Transformamos cocinas, baños, recámaras y fachadas para darles nueva vida.',
		image: 'https://images.unsplash.com/photo-1682888818650-0a7cbb35287d?auto=format&fit=crop&q=80',
		icon: 'gear',
	},
	{
		title: 'Plomería',
		description: 'Instalaciones hidráulicas, sanitarias, reparación de fugas y colocación de muebles.',
		image: 'https://images.unsplash.com/photo-1766330977065-4458b54c6d1a?auto=format&fit=crop&q=80',
		icon: 'mix',
	},
	{
		title: 'Acabados y Pintura',
		description: 'Aplicación de yeso, pasta, estuco, pintura vinílica y esmalte para interiores y exteriores.',
		image: 'https://images.unsplash.com/photo-1621870536986-151d03e2e99a?auto=format&fit=crop&q=80',
		icon: 'magic-wand',
	},
	{
		title: 'Electricidad',
		description: 'Cableado, colocación de centros de carga, contactos, apagadores y luminarias.',
		image: 'https://images.unsplash.com/photo-1595831708961-1b13c0dd2422?auto=format&fit=crop&q=80',
		icon: 'lightning',
	},
	{
		title: 'Pisos y Azulejos',
		description: 'Colocación experta de loseta cerámica, porcelanato, mármol y zoclos.',
		image: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&q=80',
		icon: 'ruler',
	},
];
---

<section id="servicios" class="services-section">
	<div class="services-inner">
		<div class="services-heading">
			<p>Nuestros Servicios</p>
			<h2>Todo lo que necesitas para tu obra</h2>
			<span>
				Ofrecemos soluciones integrales. Desde la primera piedra hasta el último detalle de pintura, nuestro equipo se encarga de todo con profesionalismo.
			</span>
		</div>

		<div class="services-grid">
			{
				services.map((service) => (
					<article class="service-card">
						<div class="service-image">
							<img src={service.image} alt={service.title} loading="lazy" />
						</div>
						<div class="service-body">
							<div class="service-title-row">
								<div class="service-icon">
									{service.icon === 'hobby-knife' && <HobbyKnifeIcon aria-hidden="true" />}
									{service.icon === 'gear' && <GearIcon aria-hidden="true" />}
									{service.icon === 'mix' && <MixIcon aria-hidden="true" />}
									{service.icon === 'magic-wand' && <MagicWandIcon aria-hidden="true" />}
									{service.icon === 'lightning' && <LightningBoltIcon aria-hidden="true" />}
									{service.icon === 'ruler' && <RulerSquareIcon aria-hidden="true" />}
								</div>
								<h3>{service.title}</h3>
							</div>
							<p>{service.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.services-section {
		background: #ffffff;
		color: #0f172a;
		padding: 80px 0 74px;
	}

	.services-inner {
		width: min(1216px, calc(100% - 48px));
		margin: 0 auto;
	}

	.services-heading {
		max-width: 780px;
		margin: 0 auto 68px;
		text-align: center;
	}

	.services-heading p {
		margin: 0 0 14px;
		color: #005f6b;
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.08em;
		line-height: 1;
		text-transform: uppercase;
	}

	.services-heading h2 {
		margin: 0;
		color: #0f172a;
		font-size: clamp(36px, 3.2vw, 44px);
		font-weight: 950;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.services-heading span {
		display: block;
		max-width: 760px;
		margin: 20px auto 0;
		color: #475569;
		font-size: 18px;
		font-weight: 500;
		line-height: 1.55;
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 34px;
	}

	.service-card {
		position: relative;
		overflow: hidden;
		border: 1px solid #eef2f7;
		border-radius: 12px;
		background: #ffffff;
		box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
		transition:
			border-color 220ms ease,
			box-shadow 220ms ease,
			transform 220ms ease;
	}

	.service-card:hover,
	.service-card:focus-within {
		border-color: rgba(37, 174, 182, 0.35);
		box-shadow: 0 18px 36px rgba(0, 95, 107, 0.2);
		transform: translateY(-4px);
	}

	.service-image {
		height: 192px;
		overflow: hidden;
		background: #0f172a;
	}

	.service-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: brightness(0.78);
		transition:
			filter 220ms ease,
			transform 260ms ease;
	}

	.service-card:hover img,
	.service-card:focus-within img {
		filter: brightness(0.88);
		transform: scale(1.03);
	}

	.service-body {
		padding: 24px 24px 26px;
	}

	.service-title-row {
		display: flex;
		gap: 14px;
		align-items: center;
	}

	.service-icon {
		display: grid;
		width: 36px;
		height: 36px;
		place-items: center;
		border-radius: 8px;
		background: #b9dce1;
		color: #005f6b;
		transition:
			background 220ms ease,
			box-shadow 220ms ease,
			color 220ms ease,
			transform 220ms ease;
	}

	.service-icon svg {
		width: 20px;
		height: 20px;
	}

	.service-card:hover .service-icon,
	.service-card:focus-within .service-icon {
		background: #005f6b;
		color: #ffffff;
		box-shadow: 0 10px 22px rgba(0, 95, 107, 0.3);
		transform: translateY(-54px);
	}

	.service-card h3 {
		margin: 0;
		color: #0f172a;
		font-size: 20px;
		font-weight: 950;
		line-height: 1.2;
	}

	.service-card p {
		margin: 16px 0 0;
		color: #475569;
		font-size: 16px;
		font-weight: 500;
		line-height: 1.62;
	}

	@media (max-width: 980px) {
		.services-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.services-section {
			padding: 58px 0 60px;
		}

		.services-inner {
			width: calc(100% - 24px);
		}

		.services-heading {
			margin-bottom: 40px;
			text-align: left;
		}

		.services-heading h2 {
			font-size: 34px;
		}

		.services-heading span {
			font-size: 16px;
		}

		.services-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.service-card img {
			height: 180px;
		}
	}

	@media (max-width: 430px) {
		.services-section {
			padding: 48px 0 54px;
		}

		.services-inner {
			width: calc(100% - 20px);
		}

		.services-heading h2 {
			font-size: 30px;
		}

		.services-grid {
			gap: 20px;
		}

		.service-card img {
			height: 168px;
		}

		.service-body {
			padding: 20px;
		}

		.service-title-row {
			align-items: start;
		}

		.service-card h3 {
			font-size: 19px;
		}
	}
</style>
