---
const stats = [
	{ value: '20+', label: 'Años de experiencia' },
	{ value: '500+', label: 'Obras terminadas' },
	{ value: '100%', label: 'Clientes satisfechos' },
];
---

<section id="inicio" class="hero-section">
	<div class="hero-inner">
		<div class="hero-content">
			<p class="hero-badge">
				<span aria-hidden="true">✓</span>
				Maestro de Obra 100% Confiable en México
			</p>

			<h1 class="hero-title">
				Construimos tus ideas con la <span>solidez y calidad</span> que mereces.
			</h1>

			<p class="hero-description">
				Especialistas en albañilería, remodelación y acabados. Más de 20 años de experiencia haciendo obras bien hechas, a tiempo y dentro del presupuesto. ¡Cero dolores de cabeza!
			</p>

			<div class="hero-actions">
				<a href="#cotizar" class="hero-button hero-button-primary">
					Solicitar Presupuesto
					<span aria-hidden="true">→</span>
				</a>

				<a href="#cotizar" class="hero-button hero-button-secondary">
					<span aria-hidden="true">☏</span>
					Llamar Ahora
				</a>
			</div>
		</div>

		<div class="hero-stats">
			{
				stats.map((stat) => (
					<div class="hero-stat">
						<p>{stat.value}</p>
						<span>{stat.label}</span>
					</div>
				))
			}
		</div>
	</div>

	<a href="#cotizar" class="whatsapp-button" aria-label="Contactar por WhatsApp">
		<svg aria-hidden="true" viewBox="0 0 32 32" fill="currentColor">
			<path d="M16.04 4.01a11.82 11.82 0 0 0-10.1 17.93L4.5 27.25l5.44-1.42A11.82 11.82 0 1 0 16.04 4Zm0 21.67a9.75 9.75 0 0 1-4.98-1.36l-.36-.21-3.22.84.86-3.14-.24-.38a9.76 9.76 0 1 1 7.94 4.25Zm5.36-7.31c-.29-.15-1.74-.86-2.01-.96-.27-.1-.47-.15-.67.15-.2.29-.77.96-.95 1.16-.17.2-.35.22-.64.07-.29-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.64-2.03-.17-.29-.02-.45.13-.6.13-.13.29-.35.44-.52.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.29-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.21 5.1 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.89.12.58-.09 1.74-.71 1.99-1.39.25-.68.25-1.27.17-1.39-.07-.12-.26-.19-.56-.34Z" />
		</svg>
	</a>
</section>

<style>
	.hero-section {
		position: relative;
		isolation: isolate;
		min-height: calc(100svh - 80px);
		overflow: hidden;
		color: #ffffff;
		background:
			linear-gradient(90deg, rgba(7, 18, 37, 0.86) 0%, rgba(15, 29, 55, 0.7) 48%, rgba(17, 34, 63, 0.62) 100%),
			linear-gradient(rgba(20, 33, 61, 0.48), rgba(20, 33, 61, 0.48)),
			url('https://images.unsplash.com/photo-1613353557237-2baa9d271861?auto=format&fit=crop&q=80') center / cover no-repeat;
	}

	.hero-inner {
		width: min(1216px, calc(100% - 48px));
		min-height: calc(100svh - 80px);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 48px 0 42px;
	}

	.hero-content {
		max-width: 735px;
		margin-left: 40px;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 28px;
		padding: 6px 14px;
		border-radius: 999px;
		background: rgba(0, 95, 107, 0.7);
		color: #36c2c7;
		font-size: 14px;
		font-weight: 800;
		line-height: 1;
		box-shadow: inset 0 0 0 1px rgba(54, 194, 199, 0.16);
	}

	.hero-badge span {
		display: grid;
		width: 16px;
		height: 16px;
		place-items: center;
		border-radius: 999px;
		border: 1px solid rgba(54, 194, 199, 0.5);
		font-size: 12px;
	}

	.hero-title {
		max-width: 820px;
		margin: 0;
		color: #ffffff;
		font-size: clamp(44px, 5vw, 64px);
		font-weight: 950;
		line-height: 1.16;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-title span {
		color: #007f87;
	}

	.hero-description {
		max-width: 710px;
		margin: 24px 0 0;
		color: rgba(255, 255, 255, 0.92);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.65;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: 30px;
	}

	.hero-button {
		display: inline-flex;
		min-height: 62px;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 0 32px;
		border-radius: 6px;
		color: #ffffff;
		font-size: 18px;
		font-weight: 900;
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 14px 28px rgba(0, 0, 0, 0.2);
		transition:
			background 180ms ease,
			transform 180ms ease,
			border-color 180ms ease;
	}

	.hero-button:hover,
	.hero-button:focus-visible {
		transform: translateY(-1px);
	}

	.hero-button-primary {
		background: #005f6b;
	}

	.hero-button-primary:hover,
	.hero-button-primary:focus-visible {
		background: #007481;
	}

	.hero-button-secondary {
		border: 1px solid rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
	}

	.hero-button-secondary:hover,
	.hero-button-secondary:focus-visible {
		background: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.45);
	}

	.hero-stats {
		display: grid;
		width: min(670px, 100%);
		grid-template-columns: repeat(3, 1fr);
		gap: 48px;
		margin-top: 82px;
		margin-left: 40px;
	}

	.hero-stat p {
		margin: 0;
		color: #25aeb6;
		font-size: 32px;
		font-weight: 950;
		line-height: 1;
	}

	.hero-stat span {
		display: block;
		margin-top: 8px;
		color: rgba(255, 255, 255, 0.82);
		font-size: 14px;
		font-weight: 800;
		line-height: 1.2;
	}

	.whatsapp-button {
		position: fixed;
		right: 24px;
		bottom: 24px;
		z-index: 40;
		display: grid;
		width: 58px;
		height: 58px;
		place-items: center;
		border-radius: 999px;
		background: #25d366;
		color: #ffffff;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
		text-decoration: none;
		transition:
			background 180ms ease,
			transform 180ms ease;
	}

	.whatsapp-button:hover,
	.whatsapp-button:focus-visible {
		background: #20bd5a;
		transform: scale(1.05);
	}

	.whatsapp-button svg {
		width: 34px;
		height: 34px;
	}

	@media (max-width: 860px) {
		.hero-section,
		.hero-inner {
			min-height: calc(100svh - 76px);
		}

		.hero-inner {
			width: min(100% - 32px, 720px);
		}

		.hero-content,
		.hero-stats {
			margin-left: 0;
		}

		.hero-title {
			font-size: clamp(40px, 9vw, 56px);
		}

		.hero-description {
			font-size: 18px;
		}
	}

	@media (max-width: 620px) {
		.hero-section,
		.hero-inner {
			min-height: calc(100svh - 78px);
		}

		.hero-inner {
			justify-content: flex-start;
			padding: 40px 0 90px;
		}

		.hero-badge {
			margin-bottom: 22px;
			font-size: 13px;
		}

		.hero-title {
			font-size: 38px;
			line-height: 1.12;
		}

		.hero-description {
			font-size: 16px;
			line-height: 1.55;
		}

		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.hero-button {
			width: 100%;
			min-height: 56px;
		}

		.hero-stats {
			grid-template-columns: 1fr;
			gap: 22px;
			margin-top: 44px;
		}
	}

	@media (max-width: 430px) {
		.hero-inner {
			width: min(100% - 28px, 390px);
			padding: 30px 0 72px;
		}

		.hero-badge {
			max-width: 100%;
			white-space: normal;
			line-height: 1.25;
		}

		.hero-title {
			font-size: 34px;
		}

		.hero-description {
			margin-top: 20px;
		}

		.hero-actions {
			margin-top: 26px;
		}

		.hero-button {
			min-height: 54px;
			padding: 0 18px;
			font-size: 16px;
		}

		.hero-stats {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 12px;
			margin-top: 36px;
		}

		.hero-stat p {
			font-size: 26px;
		}

		.hero-stat span {
			font-size: 12px;
		}

		.whatsapp-button {
			width: 52px;
			height: 52px;
			right: 16px;
			bottom: 16px;
		}
	}
</style>
