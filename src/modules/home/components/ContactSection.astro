---
import {
	ClockIcon,
	EnvelopeClosedIcon,
	MobileIcon,
	SewingPinIcon,
} from '@radix-ui/react-icons';
import LeadForm from './LeadForm.astro';

const contactItems = [
	{
		title: 'Teléfono / WhatsApp',
		lines: ['+52 (777) 175 87 39'],
		icon: MobileIcon,
	},
	{
		title: 'Correo Electrónico',
		lines: ['noe.avi@hotmail.com'],
		icon: EnvelopeClosedIcon,
	},
	{
		title: 'Área de Servicio',
		lines: ['Cuernavaca, Morelos.'],
		icon: SewingPinIcon,
	},
	{
		title: 'Horario de Atención',
		lines: ['Lunes a Viernes: 8:00 AM - 6:00 PM', 'Sábados: 8:00 AM - 2:00 PM'],
		icon: ClockIcon,
	},
];

const serviceOptions = [
	'Albañilería General',
	'Remodelaciones',
	'Plomería',
	'Acabados y Pintura',
	'Electricidad',
	'Pisos y Azulejos',
];

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
const leadsTable = import.meta.env.PUBLIC_SUPABASE_LEADS_TABLE || 'contact_leads';
---

<section id="cotizar" class="contact-section" aria-labelledby="contact-title">
	<div class="contact-inner">
		<div class="contact-copy" data-scroll-animate="fade-left">
			<p class="contact-eyebrow">Contacto</p>
			<h2 id="contact-title">¿Listo para iniciar tu proyecto?</h2>
			<p class="contact-description">
				Déjanos un mensaje con los detalles de lo que tienes en mente y nos pondremos en contacto contigo lo antes posible para agendar una visita.
			</p>

			<div class="contact-list">
				{
					contactItems.map((item) => {
						const Icon = item.icon;

						return (
							<div class="contact-item">
								<div class="contact-icon">
									<Icon aria-hidden="true" />
								</div>
								<div>
									<h3>{item.title}</h3>
									{
										item.lines.map((line) => (
											<p>{line}</p>
										))
									}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>

		<LeadForm
			serviceOptions={serviceOptions}
			supabaseUrl={supabaseUrl}
			supabaseKey={supabaseKey}
			leadsTable={leadsTable}
		/>
	</div>

</section>

<style>
	.contact-section {
		background: var(--color-surface);
		color: var(--color-text);
		padding: 76px 0 86px;
	}

	.contact-inner {
		display: grid;
		width: min(1216px, calc(100% - 48px));
		margin: 0 auto;
		grid-template-columns: minmax(0, 1fr) minmax(460px, 576px);
		gap: 82px;
		align-items: start;
	}

	.contact-eyebrow {
		margin: 0 0 14px;
		color: var(--color-brand);
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.09em;
		line-height: 1;
		text-transform: uppercase;
	}

	.contact-copy h2 {
		max-width: 620px;
		margin: 0;
		color: var(--color-text);
		font-size: clamp(36px, 3.2vw, 44px);
		font-weight: 950;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.contact-description {
		max-width: 560px;
		margin: 24px 0 0;
		color: var(--color-text-muted);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.6;
	}

	.contact-list {
		display: grid;
		gap: 28px;
		margin-top: 34px;
	}

	.contact-item {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 16px;
		align-items: start;
	}

	.contact-icon {
		display: grid;
		width: 48px;
		height: 48px;
		place-items: center;
		border-radius: 8px;
		background: var(--color-brand-soft-alt);
		color: var(--color-brand);
	}

	.contact-icon svg {
		width: 24px;
		height: 24px;
	}

	.contact-item h3 {
		margin: 4px 0 8px;
		color: var(--color-text);
		font-size: 18px;
		font-weight: 950;
		line-height: 1.2;
	}

	.contact-item p {
		margin: 4px 0 0;
		color: var(--color-text-muted);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.35;
	}

	.contact-copy[data-scroll-animate],
	:global(.quote-form[data-scroll-animate]) {
		opacity: 0;
	}

	.contact-copy.is-scroll-visible,
	:global(.quote-form.is-scroll-visible) {
		opacity: 1;
	}

	@media (max-width: 980px) {
		.contact-inner {
			grid-template-columns: 1fr;
			gap: 46px;
		}

	}

	@media (max-width: 620px) {
		.contact-section {
			padding: 58px 0 64px;
		}

		.contact-inner {
			width: calc(100% - 24px);
			gap: 38px;
		}

		.contact-copy h2 {
			font-size: 34px;
		}

		.contact-description {
			font-size: 16px;
		}

	}

	@media (max-width: 430px) {
		.contact-section {
			padding: 48px 0 54px;
		}

		.contact-inner {
			width: calc(100% - 20px);
		}

		.contact-copy h2 {
			font-size: 30px;
		}

		.contact-item {
			grid-template-columns: 44px 1fr;
			gap: 14px;
		}

		.contact-icon {
			width: 44px;
			height: 44px;
		}

		.contact-item h3 {
			font-size: 17px;
		}

	}
</style>
