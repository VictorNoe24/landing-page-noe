---
import {
	ClockIcon,
	EnvelopeClosedIcon,
	MobileIcon,
	PaperPlaneIcon,
	SewingPinIcon,
} from '@radix-ui/react-icons';

const contactItems = [
	{
		title: 'Teléfono / WhatsApp',
		lines: ['+52 (777) 175 87 39'],
		icon: MobileIcon,
	},
	{
		title: 'Correo Electrónico',
		lines: ['noe.avi@hotmail.com'],
		icon: EnvelopeClosedIcon,
	},
	{
		title: 'Área de Servicio',
		lines: ['Cuernavaca, Morelos.'],
		icon: SewingPinIcon,
	},
	{
		title: 'Horario de Atención',
		lines: ['Lunes a Viernes: 8:00 AM - 6:00 PM', 'Sábados: 8:00 AM - 2:00 PM'],
		icon: ClockIcon,
	},
];

const serviceOptions = [
	'Albañilería General',
	'Remodelaciones',
	'Plomería',
	'Acabados y Pintura',
	'Electricidad',
	'Pisos y Azulejos',
];
---

<section id="cotizar" class="contact-section" aria-labelledby="contact-title">
	<div class="contact-inner">
		<div class="contact-copy" data-scroll-animate="fade-left">
			<p class="contact-eyebrow">Contacto</p>
			<h2 id="contact-title">¿Listo para iniciar tu proyecto?</h2>
			<p class="contact-description">
				Déjanos un mensaje con los detalles de lo que tienes en mente y nos pondremos en contacto contigo lo antes posible para agendar una visita.
			</p>

			<div class="contact-list">
				{
					contactItems.map((item) => {
						const Icon = item.icon;

						return (
							<div class="contact-item">
								<div class="contact-icon">
									<Icon aria-hidden="true" />
								</div>
								<div>
									<h3>{item.title}</h3>
									{
										item.lines.map((line) => (
											<p>{line}</p>
										))
									}
								</div>
							</div>
						);
					})
				}
			</div>
		</div>

		<form class="quote-form" action="#" method="post" data-scroll-animate="fade-right">
			<h3>Solicita tu cotización</h3>

			<label>
				<span>Nombre Completo</span>
				<input type="text" name="name" placeholder="Ej. Juan Pérez" autocomplete="name" />
			</label>

			<div class="form-row">
				<label>
					<span>Teléfono (WhatsApp)</span>
					<input type="tel" name="phone" placeholder="Ej. 55 1234 5678" autocomplete="tel" />
				</label>

				<label>
					<span>Tipo de Servicio</span>
					<select name="service">
						{
							serviceOptions.map((option) => (
								<option value={option}>{option}</option>
							))
						}
					</select>
				</label>
			</div>

			<label>
				<span>Mensaje o Detalles del Proyecto</span>
				<textarea name="message" placeholder="Cuéntanos brevemente qué necesitas construir, remodelar o reparar..."></textarea>
			</label>

			<button type="submit">
				<PaperPlaneIcon aria-hidden="true" />
				Enviar Mensaje
			</button>

			<p class="form-note">Tus datos están seguros y no enviamos spam.</p>
		</form>
	</div>

</section>

<style>
	.contact-section {
		background: var(--color-surface);
		color: var(--color-text);
		padding: 76px 0 86px;
	}

	.contact-inner {
		display: grid;
		width: min(1216px, calc(100% - 48px));
		margin: 0 auto;
		grid-template-columns: minmax(0, 1fr) minmax(460px, 576px);
		gap: 82px;
		align-items: start;
	}

	.contact-eyebrow {
		margin: 0 0 14px;
		color: var(--color-brand);
		font-size: 14px;
		font-weight: 950;
		letter-spacing: 0.09em;
		line-height: 1;
		text-transform: uppercase;
	}

	.contact-copy h2 {
		max-width: 620px;
		margin: 0;
		color: var(--color-text);
		font-size: clamp(36px, 3.2vw, 44px);
		font-weight: 950;
		line-height: 1.15;
		letter-spacing: 0;
	}

	.contact-description {
		max-width: 560px;
		margin: 24px 0 0;
		color: var(--color-text-muted);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.6;
	}

	.contact-list {
		display: grid;
		gap: 28px;
		margin-top: 34px;
	}

	.contact-item {
		display: grid;
		grid-template-columns: 48px 1fr;
		gap: 16px;
		align-items: start;
	}

	.contact-icon {
		display: grid;
		width: 48px;
		height: 48px;
		place-items: center;
		border-radius: 8px;
		background: var(--color-brand-soft-alt);
		color: var(--color-brand);
	}

	.contact-icon svg {
		width: 24px;
		height: 24px;
	}

	.contact-item h3 {
		margin: 4px 0 8px;
		color: var(--color-text);
		font-size: 18px;
		font-weight: 950;
		line-height: 1.2;
	}

	.contact-item p {
		margin: 4px 0 0;
		color: var(--color-text-muted);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.35;
	}

	.quote-form {
		width: 100%;
		max-width: 576px;
		padding: 32px;
		border: 1px solid var(--color-border-soft);
		border-radius: 14px;
		background: var(--color-surface-alt);
		box-shadow: 0 16px 30px var(--color-shadow-strong);
	}

	.quote-form h3 {
		margin: 0 0 26px;
		color: var(--color-text);
		font-size: 28px;
		font-weight: 950;
		line-height: 1.2;
	}

	.quote-form label {
		display: grid;
		gap: 8px;
		min-width: 0;
		margin-bottom: 17px;
	}

	.quote-form label span {
		color: var(--color-text-muted);
		font-size: 14px;
		font-weight: 850;
		line-height: 1.2;
	}

	.form-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		align-items: start;
	}

	.quote-form input,
	.quote-form select,
	.quote-form textarea {
		display: block;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		border: 1px solid var(--color-border-muted);
		border-radius: 8px;
		background: var(--color-surface-alt);
		color: var(--color-text);
		font: inherit;
		font-size: 16px;
		font-weight: 500;
		outline: none;
		transition:
			background 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.quote-form input,
	.quote-form select {
		height: 49px;
		padding: 0 16px;
	}

	.quote-form select {
		appearance: auto;
		padding-right: 42px;
	}

	.quote-form textarea {
		min-height: 122px;
		resize: vertical;
		padding: 14px 16px;
		line-height: 1.5;
	}

	.quote-form input::placeholder,
	.quote-form textarea::placeholder {
		color: var(--color-text-subtle);
	}

	.quote-form input:focus,
	.quote-form select:focus,
	.quote-form textarea:focus {
		border-color: var(--color-brand);
		background: var(--color-surface);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 16%, transparent);
	}

	.quote-form button {
		display: inline-flex;
		width: 100%;
		max-width: 100%;
		min-height: 60px;
		align-items: center;
		justify-content: center;
		gap: 12px;
		border: 0;
		border-radius: 7px;
		background: var(--color-brand);
		color: var(--color-white);
		cursor: pointer;
		font: inherit;
		font-size: 18px;
		font-weight: 950;
		box-shadow: 0 8px 16px color-mix(in srgb, var(--color-brand) 26%, transparent);
		transition:
			background 180ms ease,
			transform 180ms ease;
	}

	.quote-form button:hover,
	.quote-form button:focus-visible {
		background: color-mix(in srgb, var(--color-brand) 88%, #000000);
		transform: translateY(-1px);
	}

	.quote-form button svg {
		width: 22px;
		height: 22px;
	}

	.form-note {
		margin: 16px 0 0;
		color: var(--color-text-subtle);
		font-size: 12px;
		font-weight: 600;
		line-height: 1.3;
		text-align: center;
	}

	.contact-copy[data-scroll-animate],
	.quote-form[data-scroll-animate] {
		opacity: 0;
	}

	.contact-copy.is-scroll-visible,
	.quote-form.is-scroll-visible {
		opacity: 1;
	}

	@media (max-width: 980px) {
		.contact-inner {
			grid-template-columns: 1fr;
			gap: 46px;
		}

		.quote-form {
			width: 100%;
			max-width: 640px;
			margin: 0 auto;
		}
	}

	@media (max-width: 620px) {
		.contact-section {
			padding: 58px 0 64px;
		}

		.contact-inner {
			width: calc(100% - 24px);
			gap: 38px;
		}

		.contact-copy h2 {
			font-size: 34px;
		}

		.contact-description {
			font-size: 16px;
		}

		.form-row {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.quote-form {
			padding: 28px 20px 24px;
		}

		.quote-form h3 {
			font-size: 26px;
		}
	}

	@media (max-width: 430px) {
		.contact-section {
			padding: 48px 0 54px;
		}

		.contact-inner {
			width: calc(100% - 20px);
		}

		.contact-copy h2 {
			font-size: 30px;
		}

		.contact-item {
			grid-template-columns: 44px 1fr;
			gap: 14px;
		}

		.contact-icon {
			width: 44px;
			height: 44px;
		}

		.contact-item h3 {
			font-size: 17px;
		}

		.quote-form {
			padding: 24px 18px 22px;
		}

		.quote-form h3 {
			font-size: 24px;
		}

		.quote-form button {
			min-height: 56px;
			font-size: 16px;
		}
	}
</style>
