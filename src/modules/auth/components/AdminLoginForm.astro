<form class="admin-login-form" data-admin-login-form>
	<p class="admin-login-alert" data-admin-login-message hidden aria-live="polite"></p>

	<label>
		<span>Correo electrónico</span>
		<input
			type="email"
			name="email"
			placeholder="tu-correo@dominio.com"
			autocomplete="email"
			required
		/>
	</label>

	<label>
		<span>Contraseña</span>
		<input
			type="password"
			name="password"
			placeholder="Ingresa tu contraseña"
			autocomplete="current-password"
			required
		/>
	</label>

	<button type="submit" data-admin-login-submit>
		<span data-admin-login-submit-label>Iniciar sesión</span>
	</button>

	<p class="admin-login-footnote">
		Acceso restringido para uso interno. Solo usuarios autorizados pueden ingresar.
	</p>
</form>

