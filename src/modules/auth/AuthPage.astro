---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminLoginForm from './components/AdminLoginForm.astro';
import AdminSidebar from './components/AdminSidebar.astro';
import ContactsPanel from '../../modules/contacts/components/ContactsPanel.astro';
---

<AdminLayout title="Admin | Contactos | Noe Flores Avilés" noindex={true}>
	<main class="admin-page" data-admin-auth-root data-authenticated="false" data-sidebar-collapsed="false">
		<div class="admin-page__sidebar" data-admin-auth-view="authenticated" hidden>
			<AdminSidebar />
		</div>

		<section class="admin-page__content">
			<div class="admin-login-shell" data-admin-auth-view="guest" hidden>
				<div class="admin-login-panel">
					<div class="admin-login-panel__visual">
						<div class="admin-login-panel__badge">Acceso privado</div>
						<h1>Panel de administración</h1>
						<p class="admin-description">
							Consulta contactos, da seguimiento comercial y gestiona tu operación interna
							desde un entorno seguro conectado con Supabase.
						</p>

						<div class="admin-login-panel__visual-grid" aria-hidden="true">
							<div class="admin-login-panel__metric">
								<span>CRM</span>
								<strong>Leads</strong>
							</div>
							<div class="admin-login-panel__metric">
								<span>Flujo</span>
								<strong>Seguimiento</strong>
							</div>
							<div class="admin-login-panel__metric">
								<span>Estado</span>
								<strong>Privado</strong>
							</div>
						</div>
					</div>

					<div class="admin-login-panel__form">
						<div class="admin-login-panel__form-copy">
							<p class="admin-login-panel__form-eyebrow">Bienvenido</p>
							<h2>Inicia sesión</h2>
							<p>
								Ingresa con tu cuenta de administrador para acceder al panel interno.
							</p>
						</div>

						<AdminLoginForm />
					</div>
				</div>
			</div>

			<div class="admin-workspace" data-admin-auth-view="authenticated" hidden>
			

				<ContactsPanel />
			</div>
		</section>
	</main>

	<script>
		import { setupAdminAuthPage } from './utils/admin-auth.js';
		import { setupContactsPanel } from '../../modules/contacts/utils/admin-contacts.js';

		setupAdminAuthPage();
		setupContactsPanel();
	</script>
</AdminLayout>

<style>
	.admin-page {
		display: grid;
		min-height: 100vh;
		grid-template-columns: 1fr;
	}

	.admin-page[data-authenticated='true'] {
		grid-template-columns: 280px minmax(0, 1fr);
	}

	.admin-page[data-authenticated='true'][data-sidebar-collapsed='true'] {
		grid-template-columns: 104px minmax(0, 1fr);
	}

	.admin-page[data-authenticated='true'] [data-admin-auth-view='guest'] {
		display: none !important;
	}

	.admin-page[data-authenticated='false'] [data-admin-auth-view='authenticated'] {
		display: none !important;
	}

	.admin-eyebrow {
		margin: 0 0 12px;
		color: var(--color-brand);
		font-size: 13px;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.admin-page h1 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 950;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.admin-description {
		margin: 18px 0 0;
		color: var(--color-text-muted);
		font-size: 16px;
		font-weight: 500;
		line-height: 1.7;
	}

	.admin-page__content {
		min-width: 0;
		padding: 28px 32px 40px;
	}

	.admin-login-shell {
		display: grid;
		width: 100%;
		min-height: 100vh;
		place-items: center;
		padding: 32px 0;
	}

	.admin-login-panel {
		display: grid;
		width: min(100%, 1120px);
		min-height: min(720px, calc(100vh - 96px));
		grid-template-columns: minmax(0, 54%) minmax(0, 46%);
		align-items: stretch;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-brand) 10%, var(--color-border-soft));
		border-radius: 32px;
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		box-shadow: 0 36px 80px var(--color-shadow-soft);
		backdrop-filter: blur(14px);
	}

	.admin-login-panel__visual {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-width: 0;
		padding: 44px;
		background:
			radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-brand-strong) 30%, transparent), transparent 32%),
			radial-gradient(circle at 80% 18%, color-mix(in srgb, var(--color-brand-soft) 32%, transparent), transparent 24%),
			linear-gradient(160deg, #0b2440 0%, #0f4860 45%, #0a7b86 100%);
		color: var(--color-white);
	}

	.admin-login-panel__visual::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(135deg, rgb(255 255 255 / 0.08) 0%, transparent 34%),
			repeating-linear-gradient(
				140deg,
				transparent 0,
				transparent 28px,
				rgb(255 255 255 / 0.05) 28px,
				rgb(255 255 255 / 0.05) 30px
			);
		pointer-events: none;
	}

	.admin-login-panel__visual > * {
		position: relative;
		z-index: 1;
	}

	.admin-login-panel__badge {
		display: inline-flex;
		width: fit-content;
		margin-bottom: auto;
		padding: 10px 14px;
		border: 1px solid rgb(255 255 255 / 0.2);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.08);
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.admin-login-panel__visual h1 {
		color: var(--color-white);
		font-size: clamp(48px, 5vw, 72px);
		line-height: 0.96;
	}

	.admin-login-panel__visual .admin-description {
		max-width: 520px;
		margin-top: 20px;
		color: rgb(233 245 247 / 0.9);
		font-size: 22px;
		line-height: 1.5;
	}

	.admin-login-panel__visual-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		margin-top: 34px;
	}

	.admin-login-panel__metric {
		padding: 18px 16px;
		border: 1px solid rgb(255 255 255 / 0.14);
		border-radius: 18px;
		background: rgb(255 255 255 / 0.08);
		backdrop-filter: blur(6px);
	}

	.admin-login-panel__metric span {
		display: block;
		color: rgb(232 245 247 / 0.78);
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.admin-login-panel__metric strong {
		display: block;
		margin-top: 10px;
		font-size: 20px;
		font-weight: 900;
		line-height: 1.1;
	}

	.admin-login-panel__form {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
		padding: 54px 48px;
		border-left: 1px solid color-mix(in srgb, var(--color-brand) 8%, var(--color-border-soft));
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 98%, transparent) 0%, var(--color-surface) 100%);
	}

	.admin-login-panel__form-copy {
		max-width: 420px;
	}

	.admin-login-panel__form-eyebrow {
		margin: 0 0 10px;
		color: var(--color-brand);
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.admin-login-panel__form-copy h2 {
		margin: 0;
		color: var(--color-text);
		font-size: clamp(34px, 4vw, 46px);
		font-weight: 950;
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.admin-login-panel__form-copy p {
		margin: 14px 0 0;
		color: var(--color-text-muted);
		font-size: 16px;
		line-height: 1.7;
	}

	.admin-workspace {
		width: 100%;
		max-width: none;
	}

	.admin-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 8px 4px 24px;
		border-bottom: 1px solid var(--color-border-soft);
	}

	.admin-topbar__title-group {
		min-width: 0;
	}

	.admin-topbar__actions {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.admin-topbar__link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--color-text-muted);
		font-size: 15px;
		font-weight: 800;
		text-decoration: none;
	}

	.admin-topbar__icon-button {
		display: inline-flex;
		width: 48px;
		height: 48px;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-border-muted);
		border-radius: 16px;
		background: var(--color-surface);
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.admin-topbar__avatar {
		display: inline-flex;
		width: 48px;
		height: 48px;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-brand-strong) 100%);
		color: var(--color-white);
		box-shadow: 0 14px 26px color-mix(in srgb, var(--color-brand) 20%, transparent);
	}

	.admin-topbar__icon-button svg,
	.admin-topbar__avatar svg,
	.admin-topbar__link svg {
		width: 20px;
		height: 20px;
	}

	@media (max-width: 980px) {
		.admin-page {
			grid-template-columns: 1fr;
		}

		.admin-page__content {
			padding: 18px 14px 32px;
		}

		.admin-page[data-authenticated='true'],
		.admin-page[data-authenticated='true'][data-sidebar-collapsed='true'] {
			grid-template-columns: 1fr;
		}

		.admin-login-shell {
			padding: 14px 0;
		}

		.admin-login-panel {
			min-height: auto;
			grid-template-columns: 1fr;
		}

		.admin-login-panel__visual {
			min-height: 320px;
			padding: 30px 24px;
		}

		.admin-login-panel__visual-grid {
			grid-template-columns: 1fr;
		}

		.admin-login-panel__form {
			padding: 30px 24px 28px;
			border-left: 0;
			border-top: 1px solid color-mix(in srgb, var(--color-brand) 8%, var(--color-border-soft));
		}

		.admin-topbar {
			flex-direction: column;
			align-items: flex-start;
		}

		.admin-topbar__actions {
			width: 100%;
			justify-content: space-between;
		}
	}

	@media (max-width: 640px) {
		.admin-page h1 {
			font-size: 30px;
		}

		.admin-login-panel {
			border-radius: 24px;
		}

		.admin-login-panel__visual {
			min-height: 280px;
			padding: 24px 18px;
		}

		.admin-login-panel__visual .admin-description {
			font-size: 18px;
		}

		.admin-login-panel__form {
			padding: 24px 18px 22px;
		}
	}
</style>
